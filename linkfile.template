ENTRY(_start)
SECTIONS {
    . = _PROGRAM_ENTRY;
    .text : { KEEP(*(.text.entry)) *(.text .text.*) }
    .rodata ALIGN(16) : { *(.rodata .rodata.*) . = ALIGN(4); }
    .data ALIGN(16) : { *(.data .data.*) *(.sdata .sdata.*) . = ALIGN(4); }
    .bss ALIGN(16) : { *(.bss .bss.*) *(.sbss .sbss.*) *(COMMON) }
    _payload_end = .;
    /DISCARD/ : { *(.reginfo) *(.MIPS.abiflags) *(.pdr) *(.comment) *(.gnu.attributes) }
}

#if __GNUC__ >= 4
ASSERT(_PROGRAM_ENTRY >= 0x000f0000 && _PROGRAM_ENTRY < 0x00100000,
           "Payload must fit in the low-memory cheat area")
ASSERT((_PROGRAM_ENTRY & 15) == 0, "Payload must be 16-byte aligned")
ASSERT(SIZEOF(.bss) == 0, "Use initialized data; the hook does not initialize BSS")
ASSERT(_payload_end <= 0x00100000, "Payload overlaps game memory")

#endif
